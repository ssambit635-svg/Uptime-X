# Copy to .env for local development. Never commit the real file.
APP_ENV=development
# SQLite is a development convenience; Docker Compose uses PostgreSQL.
DATABASE_URL=sqlite:///./.local/uptimex.db
SESSION_COOKIE_SECURE=false
# HTTPS embedded previews only; enables partitioned cookies plus an explicit,
# JS-readable short-lived session fallback when the embedding browser blocks cookies.
# Not allowed in production. Keep false for ordinary local HTTP development.
EMBEDDED_PREVIEW=false
PREVIEW_SESSION_MINUTES=60
# Optional single-port app preview after `npm run build --prefix frontend`.
# Paths are relative to the API process working directory; rebuild after UI edits.
# FRONTEND_DIST=frontend/dist
SESSION_HOURS=168
# Vite proxies /api to this server; browser requests remain same-origin.
API_PROXY_TARGET=http://127.0.0.1:8000
# Compose-only local credentials; replace for any shared environment.
POSTGRES_USER=uptimex
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=uptimex
